# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The PUBLISHABLE key (sb_publishable_...). Never use the secret key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR-KEY
# Optional: free key from https://api.nasa.gov for the NASA picture of the day
VITE_NASA_API_KEY=
# Optional extra base maps for the field-site maps (they appear in the map's layer switcher once set)
# Stadia Maps (Stamen Watercolor/Terrain, satellite): https://client.stadiamaps.com. Use a key, or add your domain there and set DOMAIN_AUTH=true instead
VITE_STADIA_KEY=
VITE_STADIA_DOMAIN_AUTH=
# Thunderforest (Outdoors, Landscape): https://www.thunderforest.com
VITE_THUNDERFOREST_KEY=
